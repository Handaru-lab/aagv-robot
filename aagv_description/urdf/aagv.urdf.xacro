<?xml version="1.0"?>
<robot name="aagv" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="use_sim" default="true"/>

  <xacro:property name="arm_mount_z" value="0.25"/>
  <xacro:property name="cam_xyz" value="0.072 0.0 0.04"/>
  <xacro:property name="cam_rpy" value="0.0 0.0 0.0"/>

  <!-- world anchor: a link named 'world' is treated as fixed by Gazebo, so the model stays put -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- AGV base -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry><box size="0.6 0.4 0.2"/></geometry>
      <material name="agv_gray"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
  </link>

  <!-- arm geometry -->
  <xacro:include filename="$(find open_manipulator_description)/urdf/open_manipulator_x/open_manipulator_x_arm.urdf.xacro"/>
  <joint name="arm_mount_joint" type="fixed">
    <origin xyz="0 0 ${arm_mount_z}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="link1"/>
  </joint>
  <xacro:open_manipulator_x prefix=""/>

  <!-- gazebo + ros2_control machinery (reused from open_manipulator) -->
  <xacro:include filename="$(find open_manipulator_description)/gazebo/open_manipulator_x.gazebo.xacro"/>
  <xacro:include filename="$(find open_manipulator_description)/ros2_control/open_manipulator_x_position.ros2_control.xacro"/>
  <xacro:open_manipulator_x_gazebo prefix=""/>
  <xacro:open_manipulator_x_system
    name="OpenManipulatorXSystem" prefix=""
    use_sim="$(arg use_sim)" use_mock_hardware="false"
    mock_sensor_commands="false" port_name="/dev/ttyUSB0"/>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find open_manipulator_bringup)/config/open_manipulator_x/hardware_controller_manager.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- RealSense D435i, eye-in-hand on link5 -->
  <xacro:include filename="$(find realsense2_description)/urdf/_d435i.urdf.xacro"/>
  <xacro:sensor_d435i parent="link5" name="camera" use_nominal_extrinsics="true">
    <origin xyz="${cam_xyz}" rpy="${cam_rpy}"/>
  </xacro:sensor_d435i>
  <gazebo reference="camera_link">
    <sensor name="d435i" type="rgbd_camera">
      <update_rate>30</update_rate>
      <always_on>1</always_on>
      <topic>camera</topic>
      <gz_frame_id>camera_color_optical_frame</gz_frame_id>
      <camera>
        <horizontal_fov>1.211</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.1</near><far>8.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- on-demand grasp: attach/detach the ball to the gripper via gz topics -->
  <gazebo>
    <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
      <parent_link>end_effector_link</parent_link>
      <child_model>ball_orange</child_model>
      <child_link>link</child_link>
      <suppress_initial_attach>true</suppress_initial_attach>
      <attach_topic>/grasp/attach</attach_topic>
      <detach_topic>/grasp/detach</detach_topic>
    </plugin>
  </gazebo>

</robot>
