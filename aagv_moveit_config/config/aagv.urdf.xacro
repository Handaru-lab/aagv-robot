<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="aagv">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import aagv urdf file -->
    <xacro:include filename="/tmp/aagv.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="aagv.ros2_control.xacro" />


    <xacro:aagv_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
